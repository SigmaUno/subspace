+package server_test
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/SigmaUno/subspace/internal/servertest"
+)
+
+func TestGetHillclimbJob(t *testing.T) {
+	ts := servertest.New(t)
+	b := ts.CreateBrief(t, "B", []string{"o/r"})
+	var job map[string]any
+	ts.Owner(t, http.MethodPost, "/api/v1/hillclimb/jobs", map[string]any{"brief_id": b.ID, "repo": "o/r", "metric_cmd": "true", "direction": "min"}, http.StatusCreated, &job)
+	var got map[string]any
+	ts.Owner(t, http.MethodGet, "/api/v1/hillclimb/jobs/"+job["id"].(string), nil, http.StatusOK, &got)
+	if got["id"] != job["id"] {
+		t.Fatalf("got %v", got)
+	}
+}

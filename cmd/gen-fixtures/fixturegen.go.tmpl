func tasks() []*model.Task {
	mk := func(id, brief, plan, slug, status string, f func(*model.Task)) *model.Task {
		t := &model.Task{
			ID: id, BriefID: brief, PlanID: plan, Title: slug, Spec: "Implement " + slug + " as described in the brief.",
			AcceptanceCriteria: []string{"tests pass", "PR opened against main"},
			Repo:               "SigmaUno/subspace", Branch: "sub/" + id + "-" + slug, Role: model.RoleWorker,
			DependsOn: []string{}, Status: status, CreatedAt: at(31), UpdatedAt: at(31),
		}
		if f != nil {
			f(t)
		}
		return t
	}
	assigned := func(worker, reviewer string) func(*model.Task) {
		return func(t *model.Task) {
			t.Assignee = sp(worker)
			if reviewer != "" {
				t.Reviewer = sp(reviewer)
			}
			t.ClaimedAt = tp(at(50))
			t.UpdatedAt = at(90)
		}
	}
	pr := func(n string) func(*model.Task) {
		return func(t *model.Task) { t.PRURL = sp("https://github.com/SigmaUno/subspace/pull/" + n) }
	}
	return []*model.Task{
		mk("T-1", "B-1", "P-1", "webhook-handler", "done", func(t *model.Task) {
			assigned("worker-1", "reviewer-1")(t)
			pr("12")(t)
			t.ProgressPct, t.CostUsed, t.MinutesUsed, t.ReviewRounds = 100, 2.4, 45, 1
			t.Tests = &model.TestResult{Passed: 12, ReportedAt: at(80)}
		}),
		mk("T-2", "B-1", "P-1", "signature-check", "approved", func(t *model.Task) {
			assigned("worker-1", "reviewer-1")(t)
			pr("13")(t)
			t.DependsOn = []string{"T-1"}
			t.ProgressPct, t.CostUsed, t.MinutesUsed = 100, 1.1, 30
		}),
		mk("T-3", "B-1", "P-1", "replay-guard", "in_review", func(t *model.Task) {
			assigned("worker-2", "reviewer-1")(t)
			pr("14")(t)
			t.ProgressPct, t.CostUsed, t.MinutesUsed = 100, 0.9, 25
		}),
		mk("T-4", "B-1", "P-1", "delivery-ids", "submitted", func(t *model.Task) {
			assigned("worker-1", "")(t)
			pr("15")(t)
			t.ProgressPct, t.CostUsed, t.MinutesUsed = 100, 0.6, 20
		}),
		mk("T-5", "B-1", "P-1", "body-limit", "changes_requested", func(t *model.Task) {
			assigned("worker-2", "reviewer-1")(t)
			pr("16")(t)
			t.ProgressPct, t.CostUsed, t.MinutesUsed, t.ReviewRounds = 90, 0.8, 22, 1
		}),
		mk("T-6", "B-1", "P-1", "forgejo-events", "in_progress", func(t *model.Task) {
			assigned("worker-2", "")(t)
			t.ProgressPct, t.CostUsed, t.MinutesUsed = 40, 0.4, 12
			t.Budget = model.Budget{MaxMinutes: 120, MaxCostEUR: 5}
			t.LastHeartbeatAt, t.LeaseExpiresAt = tp(at(110)), tp(at(135))
			{{- if .TaskFields}}
			t.Priority, t.ComponentID = 5, sp("C-1")
			{{- end}}
			{{- if .LeaseExpiries}}
			t.LeaseExpiries = 1
			{{- end}}
		}),
		mk("T-7", "B-1", "P-1", "event-metrics", "assigned", func(t *model.Task) {
			t.Assignee = sp("worker-1")
			t.UpdatedAt = at(95)
		}),
		mk("T-8", "B-1", "P-1", "operator-docs", "ready", func(t *model.Task) { t.Role = model.RoleTester }),
		mk("T-9", "B-1", "P-1", "retry-queue", "blocked", func(t *model.Task) {
			assigned("worker-1", "")(t)
			t.ProgressPct, t.CostUsed, t.MinutesUsed = 60, 5.2, 70
			t.Budget = model.Budget{MaxMinutes: 60, MaxCostEUR: 5}
			t.BlockedReason = sp("budget_exceeded")
		}),
		mk("T-10", "B-1", "P-1", "dedupe-events", "needs_owner", func(t *model.Task) {
			assigned("worker-2", "reviewer-1")(t)
			pr("17")(t)
			t.ProgressPct, t.ReviewRounds = 100, 3
			t.BlockedReason = sp("3 changes_requested rounds")
		}),
		mk("T-11", "B-1", "P-1", "polling-fallback", "cancelled", nil),
		mk("T-12", "B-2", "P-2", "prune-stale-pages", "backlog", nil),
		mk("T-13", "B-2", "P-2", "fix-links", "backlog", func(t *model.Task) { t.DependsOn = []string{"T-12"} }),
	}
}

func agents() []*model.Agent {
	mk := func(id, role, kind, provider, status string, f func(*model.Agent)) *model.Agent {
		a := &model.Agent{
			ID: id, Role: role, Kind: kind, Model: "model-" + provider, Provider: provider, Status: status,
			TokenHash: tokenHash(id), CreatedAt: at(2), LastSeenAt: tp(at(100)),
		}
		if f != nil {
			f(a)
		}
		return a
	}
	return []*model.Agent{
		mk("lead-1", model.RoleLeader, model.KindClaudeCode, "anthropic", model.AgentActive, nil),
		mk("worker-1", model.RoleWorker, model.KindClaudeCode, "anthropic", model.AgentActive, nil),
		mk("worker-2", model.RoleWorker, model.KindCodex, "openai", model.AgentActive, func(a *model.Agent) {
			a.Spawned = true
			{{- if .TokenExpiry}}
			a.TokenExpiresAt = tp(at(60 * 24 * 30))
			{{- end}}
		}),
		mk("tester-1", model.RoleTester, model.KindOpenCode, "deepseek", model.AgentActive, nil),
		mk("reviewer-1", model.RoleReviewer, model.KindCodex, "openai", model.AgentActive, nil),
		mk("worker-3", model.RoleWorker, model.KindClaudeCode, "anthropic", model.AgentPaused, func(a *model.Agent) {
			a.PauseReason = sp("loop")
		}),
		mk("worker-4", model.RoleWorker, model.KindOpenCode, "deepseek", model.AgentRevoked, nil),
	}
}


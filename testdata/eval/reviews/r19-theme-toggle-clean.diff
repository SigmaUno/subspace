+++ b/lib/theme.ts
@@ -0,0 +1,20 @@
+export type Theme = "system" | "light" | "dark";
+
+export const THEME_KEY = "subspace.theme";
+const order: Theme[] = ["system", "light", "dark"];
+
+export function readTheme(storage: Pick<Storage, "getItem">): Theme {
+  const v = storage.getItem(THEME_KEY);
+  return order.includes(v as Theme) ? (v as Theme) : "system";
+}
+
+export function nextTheme(t: Theme): Theme {
+  return order[(order.indexOf(t) + 1) % order.length];
+}
+
+export function storeTheme(storage: Pick<Storage, "setItem">, t: Theme): void {
+  storage.setItem(THEME_KEY, t);
+}
+
+export const themeBootScript = `(function(){try{var t=localStorage.getItem("${THEME_KEY}");var d=t==="dark"||((t!=="light")&&matchMedia("(prefers-color-scheme: dark)").matches);document.documentElement.classList.toggle("dark",d)}catch(e){}})()`;
+

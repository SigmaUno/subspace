+package sqlite
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/SigmaUno/subspace/internal/model"
+)
+
+type TaskFilter struct {
+	BriefID string
+	Status  string
+}
+
+func (s *Store) ListTasksFiltered(ctx context.Context, f TaskFilter) ([]*model.Task, error) {
+	q := "SELECT " + taskColumns + " FROM tasks WHERE 1=1"
+	var args []any
+	if f.BriefID != "" {
+		q += " AND brief_id = ?"
+		args = append(args, f.BriefID)
+	}
+	if f.Status != "" {
+		q += fmt.Sprintf(" AND status = '%s'", f.Status)
+	}
+	rows, err := s.read.QueryContext(ctx, q+" ORDER BY priority DESC, id", args...)
+	if err != nil {
+		return nil, err
+	}
+	return scanTasks(rows)
+}

diff --git a/internal/audit/csv.go b/internal/audit/csv.go
new file mode 100644
--- /dev/null
+++ b/internal/audit/csv.go
@@ -0,0 +1,10 @@
+package audit
+
+import "strings"
+
+func csvCell(v string) string {
+	if v != "" && strings.ContainsRune("=+-@", rune(v[0])) {
+		return "'" + v
+	}
+	return v
+}
diff --git a/internal/audit/csv_test.go b/internal/audit/csv_test.go
new file mode 100644
--- /dev/null
+++ b/internal/audit/csv_test.go
@@ -0,0 +1,21 @@
+package audit
+
+import "testing"
+
+func TestCSVCell(t *testing.T) {
+	cases := map[string]string{
+		"=SUM(A1)":   "'=SUM(A1)",
+		"+1":         "'+1",
+		"-2":         "'-2",
+		"@cmd":       "'@cmd",
+		"claim_task": "claim_task",
+		"":           "",
+		"a=b":        "a=b",
+	}
+	for in, want := range cases {
+		if got := csvCell(in); got != want {
+			t.Errorf("csvCell(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+

{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

(replicas) {
	reverse_proxy ha-server-a:8080 ha-server-b:8080 {
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /readyz
		health_interval 2s
		health_timeout 2s
		health_status 200
		fail_duration 10s
		max_fails 1
		flush_interval -1
		transport http {
			dial_timeout 3s
			response_header_timeout 60s
		}
	}
}

{$SUBSPACE_DOMAIN::80} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	request_body {
		max_size 4MiB
	}

	@agent path /mcp* /healthz
	handle @agent {
		import replicas
	}

	handle /api/v1/events {
		reverse_proxy ha-web:3000 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	handle {
		reverse_proxy ha-web:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}
}

http://:8081 {
	request_body {
		max_size 4MiB
	}

	import replicas
}

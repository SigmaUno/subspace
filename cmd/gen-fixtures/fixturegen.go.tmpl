func auditEvents() []*model.AuditEvent {
	e := func(min int, agent, role, tool, task string, before, after map[string]any, note string) *model.AuditEvent {
		ev := &model.AuditEvent{TS: at(min), AgentID: agent, Role: role, Tool: tool, Before: before, After: after}
		if task != "" {
			ev.TaskID = sp(task)
		}
		if note != "" {
			ev.Note = sp(note)
		}
		return ev
	}
	st := func(s string) map[string]any { return map[string]any{"status": s} }
	return []*model.AuditEvent{
		e(0, "owner", "owner", "create_brief", "", nil, map[string]any{"id": "B-1"}, ""),
		e(2, "owner", "owner", "register_agent", "", nil, map[string]any{"id": "worker-1"}, ""),

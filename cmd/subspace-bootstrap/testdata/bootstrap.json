{
  "charter": {"template": "charter.md.tmpl", "vars": {"owner": "Sigma", "merge_policy": "the owner merges every PR"}},
  "profiles": [
    {"name": "opencode-tester", "role": "tester", "kind": "opencode", "model": "deepseek/deepseek-chat", "provider": "deepseek",
     "description": "Cheap fast tester on DeepSeek"}
  ],
  "leader": {"id": "lead", "kind": "other", "model": "claude-opus-5-5", "provider": "anthropic"},
  "workers": [
    {"prefix": "cc", "count": 2, "profile": "claude-code-worker"},
    {"prefix": "oc", "count": 1, "profile": "opencode-deepseek-worker"}
  ],
  "reviewer": {"id": "review", "profile": "codex-worker"},
  "tester": {"id": "test", "profile": "opencode-tester"},
  "repos": [
    {"name": "SigmaUno/demo", "host": "github", "default_branch": "main", "protected_branches": ["main"],
     "token_env": "GITHUB_TOKEN", "enabled": true}
  ],
  "capacity": {"global_max_agents": 20, "limits": [{"provider": "anthropic", "model": "*", "max_concurrency": 4, "requests_per_min": 120}]},
  "limits": {"daily_cost_eur": 25, "weekly_cost_eur": 100},
  "quality_gates": {"tests": true, "min_tests_passed": 1, "review": true},
  "autopilot": {"enabled": true},
  "brief": "brief.md",
  "secrets_file": "agents.secrets"
}

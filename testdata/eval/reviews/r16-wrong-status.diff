@@ -0,0 +1,20 @@
+package server
+
+import (
+	"net/http"
+)
+
+func init() {
+	registerMount(func(s *Server, mux *http.ServeMux) {
+		mux.Handle("GET /api/v1/hillclimb/jobs/{id}", s.owner(s.getHillclimbJob))
+	})
+}
+
+func (s *Server) getHillclimbJob(w http.ResponseWriter, r *http.Request) {
+	job, err := s.hillclimb.Job(r.Context(), r.PathValue("id"))
+	if err != nil {
+		writeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, job)
+}

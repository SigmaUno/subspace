# Host bind-mount root. Prepare subdirectories as described in deploy/README.md.
SUBSPACE_DATA=/data/subspace

# Bare DNS name for automatic HTTPS. Leave blank to serve HTTP on the IP.
SUBSPACE_DOMAIN=
# Public origin used in agent join lines and displayed MCP configurations.
SUBSPACE_PUBLIC_URL=http://localhost

# Set a strong owner token or set SUBSPACE_OWNER_TOKEN_FILE.
SUBSPACE_OWNER_TOKEN=
# Optional path inside the server container, e.g. /data/config/owner.token.
SUBSPACE_OWNER_TOKEN_FILE=

# Compose fixes the server listener and backup directory to the following
# values and disables its scheduler because the backup sidecar owns scheduling.
# SUBSPACE_ADDR=:8080
# SUBSPACE_BACKUP_DIR=/data/backups
# SUBSPACE_BACKUP_INTERVAL=0
SUBSPACE_DB=/data/db/subspace.db
SUBSPACE_BACKUP_KEEP=14
SUBSPACE_BACKUP_EVERY_SECONDS=86400

# Next.js server-to-server API origin.
SUBSPACE_API_URL=http://server:8080
# Public or direct API origin used by the CLI. Export this in the CLI shell.
SUBSPACE_URL=http://localhost

# Optional server settings. Place capacity config under /data/config.
SUBSPACE_CAPACITY_FILE=
SUBSPACE_LEASE=15m
SUBSPACE_SPAWNER=noop
SUBSPACE_HC_BIN=
SUBSPACE_HC_HOST=
SUBSPACE_HC_COMMAND=
SUBSPACE_LOG_LEVEL=info

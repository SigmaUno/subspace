		e(30, "owner", "owner", "approve_plan", "", map[string]any{"status": "proposed"}, st("approved"), "lgtm"),
		e(45, "lead-1", "leader", "assign", "T-6", st("ready"), map[string]any{"status": "assigned", "assignee": "worker-2"}, ""),
		e(50, "worker-1", "worker", "claim_task", "T-1", st("assigned"), st("in_progress"), ""),
		e(52, "worker-2", "worker", "claim_task", "T-6", st("assigned"), st("in_progress"), ""),

{
  "charter": {"template": "../charters/small-team.md"},
  "profiles": [
    {"name": "team-worker-claude", "role": "worker", "kind": "claude-code", "model": "claude-sonnet-5-5", "provider": "anthropic",
     "expires_in": "720h", "description": "Claude Code workers for the main implementation load"},
    {"name": "team-worker-deepseek", "role": "worker", "kind": "opencode", "model": "deepseek/deepseek-chat", "provider": "deepseek",
     "expires_in": "720h", "description": "OpenCode workers on DeepSeek for well-scoped tasks"},
    {"name": "team-reviewer", "role": "reviewer", "kind": "codex", "model": "gpt-5-codex", "provider": "openai",
     "expires_in": "720h", "description": "Codex reviewer on OpenAI"},
    {"name": "team-tester", "role": "tester", "kind": "opencode", "model": "deepseek/deepseek-chat", "provider": "deepseek",
     "expires_in": "720h", "description": "Tester that writes and runs tests"}
  ],
  "leader": {"id": "lead", "kind": "claude-code", "model": "claude-opus-5-5", "provider": "anthropic", "expires_in": "2160h"},
  "workers": [
    {"prefix": "claude", "count": 3, "profile": "team-worker-claude"},
    {"prefix": "deepseek", "count": 2, "profile": "team-worker-deepseek"}
  ],
  "reviewer": {"id": "review", "profile": "team-reviewer"},
  "tester": {"id": "test", "profile": "team-tester"},
  "repos": [
    {"name": "example-org/backend", "host": "github", "default_branch": "main", "protected_branches": ["main", "release/*"],
     "token_env": "GITHUB_TOKEN", "enabled": true},
    {"name": "example-org/frontend", "host": "github", "default_branch": "main", "protected_branches": ["main"],
     "token_env": "GITHUB_TOKEN", "enabled": true}
  ],
  "capacity": {
    "global_max_agents": 12,
    "limits": [
      {"provider": "anthropic", "model": "claude-opus-*", "max_concurrency": 1, "requests_per_min": 40},
      {"provider": "anthropic", "model": "*", "max_concurrency": 6, "requests_per_min": 200},
      {"provider": "openai", "model": "*", "max_concurrency": 2, "requests_per_min": 60},
      {"provider": "deepseek", "model": "*", "max_concurrency": 6, "requests_per_min": 300}
    ]
  },
  "limits": {"daily_cost_eur": 40, "weekly_cost_eur": 180},
  "quality_gates": {"tests": true, "min_tests_passed": 1, "checks": true, "review": true, "budget": true, "max_pr_age_hours": 72},
  "autopilot": {"enabled": true, "spawn": {"worker_kind": "claude-code", "model": "claude-sonnet-5-5", "profile": "team-worker-claude"}},
  "brief": "small-team-brief.md",
  "secrets_file": "team-agents.secrets"
}

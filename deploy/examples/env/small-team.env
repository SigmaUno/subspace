SUBSPACE_DATA=/data/subspace
SUBSPACE_PROXY_NETWORK=proxy
SUBSPACE_DOMAIN=subspace.example.com
SUBSPACE_PUBLIC_URL=https://subspace.example.com
SUBSPACE_API_URL=http://subspace-api:8080
SUBSPACE_DB=/data/db/subspace.db
SUBSPACE_BACKUP_KEEP=30
SUBSPACE_BACKUP_EVERY_SECONDS=43200
SUBSPACE_CAPACITY_FILE=/data/config/capacity.json
SUBSPACE_LEASE=20m
SUBSPACE_SPAWNER=hc
SUBSPACE_HC_BIN=/usr/local/bin/hc
SUBSPACE_HC_HOST=agents.example.com
SUBSPACE_HC_COMMAND=hc run --bg {agent_id} {kind} {model} {join_line}
SUBSPACE_LOG_LEVEL=info

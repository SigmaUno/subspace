+package sqlite
+
+import (
+	"context"
+	"testing"
+)
+
+func TestListTasksFilteredByStatus(t *testing.T) {
+	s := openTest(t)
+	seedTasks(t, s, "B-1", "ready", "ready", "done")
+	got, err := s.ListTasksFiltered(context.Background(), TaskFilter{BriefID: "B-1", Status: "ready"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("got %d tasks, want 2", len(got))
+	}
+}

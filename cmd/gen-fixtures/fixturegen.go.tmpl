var t0 = time.Date(2026, 11, 20, 9, 0, 0, 0, time.UTC)

func at(min int) time.Time      { return t0.Add(time.Duration(min) * time.Minute) }
func tp(t time.Time) *time.Time { return &t }
func sp(s string) *string       { return &s }

func tokenHash(id string) string {
	h := sha256.Sum256([]byte("fixture-token-" + id))
	return hex.EncodeToString(h[:])
}

func main() {
	if len(os.Args) != 2 {
		fmt.Fprintln(os.Stderr, "usage: fixturegen <db path>")
		os.Exit(2)
	}
	if err := run(os.Args[1]); err != nil {
		fmt.Fprintln(os.Stderr, "fixturegen:", err)
		os.Exit(1)
	}
}

func run(path string) error {
	for _, p := range []string{path, path + "-wal", path + "-shm"} {
		if err := os.Remove(p); err != nil && !os.IsNotExist(err) {
			return err
		}
	}
	s, err := sqlite.Open(path)
	if err != nil {
		return err
	}
	if err := s.Atomic(context.Background(), populate); err != nil {
		_ = s.Close()
		return err
	}
	if err := s.Close(); err != nil {
		return err
	}
	db, err := sql.Open("sqlite", "file:"+path)
	if err != nil {
		return err
	}
	defer func() { _ = db.Close() }()
	if _, err := db.Exec(`PRAGMA journal_mode=DELETE`); err != nil {
		return err
	}
	_, err = db.Exec(`VACUUM`)
	return err
}

func reserve(tx store.Tx, prefix, want string) error {
	got, err := tx.NextID(prefix)
	if err != nil {
		return err
	}
	if got != want {
		return fmt.Errorf("id %s, want %s", got, want)
	}
	return nil
}

func populate(tx store.Tx) error {
	for _, b := range briefs() {
		if err := reserve(tx, "B", b.ID); err != nil {
			return err
		}
		if err := tx.InsertBrief(b); err != nil {
			return err
		}
	}
	for _, p := range plans() {
		if err := reserve(tx, "P", p.ID); err != nil {
			return err
		}
		if err := tx.InsertPlan(p); err != nil {
			return err
		}
	}
	for _, t := range tasks() {
		if err := reserve(tx, "T", t.ID); err != nil {
			return err
		}
		if err := tx.InsertTask(t); err != nil {
			return err
		}
	}
	for _, a := range agents() {
		if err := tx.InsertAgent(a); err != nil {
			return err
		}
	}
	for _, m := range messages() {
		if err := tx.InsertMessage(m); err != nil {
			return err
		}
	}
	for _, q := range questions() {
		if err := reserve(tx, "Q", q.ID); err != nil {
			return err
		}
		if err := tx.InsertQuestion(q); err != nil {
			return err
		}
	}
	for _, e := range auditEvents() {
		if err := tx.InsertAudit(e); err != nil {
			return err
		}
	}
	for _, s := range spawns() {
		if err := reserve(tx, "S", s.ID); err != nil {
			return err
		}
		if err := tx.InsertSpawn(s); err != nil {
			return err
		}
	}
	return nil
}

